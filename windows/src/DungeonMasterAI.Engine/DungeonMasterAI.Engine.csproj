<Project Sdk="Microsoft.NET.Sdk">
  <!-- See DungeonMasterAI.Domain.csproj for why this is multi-targeted. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DungeonMasterAI.Domain/DungeonMasterAI.Domain.csproj" />
  </ItemGroup>
  <!--
    net10.0 gets System.Text.Json from its shared framework, so it needs no reference. The
    netstandard2.1 leg does not, and this assembly uses System.Text.Json throughout. The version is
    pinned deliberately rather than floated: it is the one dependency that has to reach Unity's
    plugin folder alongside this DLL, so it must not change under anyone without a decision.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
