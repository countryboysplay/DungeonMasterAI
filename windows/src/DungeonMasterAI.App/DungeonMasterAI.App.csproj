<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DungeonMasterAI</AssemblyName>
    <RootNamespace>DungeonMasterAI.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DungeonMasterAI.Domain/DungeonMasterAI.Domain.csproj" />
    <ProjectReference Include="../DungeonMasterAI.Engine/DungeonMasterAI.Engine.csproj" />
    <ProjectReference Include="../DungeonMasterAI.Data/DungeonMasterAI.Data.csproj" />
    <ProjectReference Include="../DungeonMasterAI.AI/DungeonMasterAI.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../reference-python/knowledge/srd_chunks.jsonl" Link="Knowledge/srd_chunks.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../reference-python/demo/sample_campaign_manifest.json" Link="Assets/Sample/sample_campaign_manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Rules/srd_spells.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Reference/home-hero-greenhaven.jpg" />
    <Content Include="Runtime/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
