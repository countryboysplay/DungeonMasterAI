<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Approved render palette -->
    <Color x:Key="AaaBg">#070B0E</Color>
    <Color x:Key="AaaBg2">#0A1015</Color>
    <Color x:Key="AaaPanel">#0D141A</Color>
    <Color x:Key="AaaPanel2">#111920</Color>
    <Color x:Key="AaaGold">#C7A25C</Color>
    <Color x:Key="AaaGoldBright">#E1C27B</Color>
    <Color x:Key="AaaBlue">#4B9BD8</Color>
    <Color x:Key="AaaGreen">#64B96C</Color>
    <Color x:Key="AaaRed">#D26057</Color>
    <Color x:Key="AaaPurple">#9B78C6</Color>
    <Color x:Key="AaaText">#EEE7D7</Color>
    <Color x:Key="AaaMutedColor">#AAA99F</Color>
    <Color x:Key="AaaBorder">#3A3328</Color>
    <Color x:Key="AaaBorderSoft">#252A2C</Color>

    <SolidColorBrush x:Key="AaaBackgroundBrush" Color="{StaticResource AaaBg}"/>
    <SolidColorBrush x:Key="AaaBackground2Brush" Color="{StaticResource AaaBg2}"/>
    <SolidColorBrush x:Key="AaaPanelBrush" Color="{StaticResource AaaPanel}"/>
    <SolidColorBrush x:Key="AaaPanel2Brush" Color="{StaticResource AaaPanel2}"/>
    <SolidColorBrush x:Key="AaaGoldBrush" Color="{StaticResource AaaGold}"/>
    <SolidColorBrush x:Key="AaaGoldBrightBrush" Color="{StaticResource AaaGoldBright}"/>
    <SolidColorBrush x:Key="AaaBlueBrush" Color="{StaticResource AaaBlue}"/>
    <SolidColorBrush x:Key="AaaGreenBrush" Color="{StaticResource AaaGreen}"/>
    <SolidColorBrush x:Key="AaaRedBrush" Color="{StaticResource AaaRed}"/>
    <SolidColorBrush x:Key="AaaPurpleBrush" Color="{StaticResource AaaPurple}"/>
    <SolidColorBrush x:Key="AaaTextBrush" Color="{StaticResource AaaText}"/>
    <SolidColorBrush x:Key="AaaMutedBrush" Color="{StaticResource AaaMutedColor}"/>
    <SolidColorBrush x:Key="AaaBorderBrush" Color="{StaticResource AaaBorder}"/>
    <SolidColorBrush x:Key="AaaBorderSoftBrush" Color="{StaticResource AaaBorderSoft}"/>

    <LinearGradientBrush x:Key="AaaWindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#05080A" Offset="0"/>
        <GradientStop Color="#091016" Offset="0.54"/>
        <GradientStop Color="#05080A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AaaGoldPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#19160F" Offset="0"/>
        <GradientStop Color="#0D1318" Offset="0.5"/>
        <GradientStop Color="#0A1014" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AaaBlueButtonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#103155" Offset="0"/>
        <GradientStop Color="#0C2238" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource AaaTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource AaaBackgroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AaaTextBrush}"/>
    </Style>

    <Style x:Key="AaaTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="31"/>
        <Setter Property="Foreground" Value="#F2E9D4"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="AaaHeroTitle" TargetType="TextBlock" BasedOn="{StaticResource AaaTitle}">
        <Setter Property="FontSize" Value="44"/>
    </Style>

    <Style x:Key="AaaSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AaaGoldBrightBrush}"/>
    </Style>

    <Style x:Key="AaaEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AaaBlueBrush}"/>
    </Style>

    <Style x:Key="AaaMuted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AaaMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="AaaPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AaaPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AaaBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AaaCardBorder" TargetType="Border" BasedOn="{StaticResource AaaPanelBorder}">
        <Setter Property="Background" Value="{StaticResource AaaGoldPanelGradient}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style x:Key="AaaTopButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource AaaTextBrush}"/>
        <Setter Property="Background" Value="#0B1116"/>
        <Setter Property="BorderBrush" Value="#30363A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="15,9"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AaaGoldBrush}"/>
                            <Setter TargetName="Root" Property="Background" Value="#131A20"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AaaPrimaryButton" TargetType="Button" BasedOn="{StaticResource AaaTopButton}">
        <Setter Property="Background" Value="{StaticResource AaaBlueButtonGradient}"/>
        <Setter Property="BorderBrush" Value="#285F91"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#4AA4F0"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AaaGoldButton" TargetType="Button" BasedOn="{StaticResource AaaTopButton}">
        <Setter Property="BorderBrush" Value="#69542E"/>
        <Setter Property="Foreground" Value="{StaticResource AaaGoldBrightBrush}"/>
    </Style>

    <Style x:Key="AaaDangerButton" TargetType="Button" BasedOn="{StaticResource AaaTopButton}">
        <Setter Property="Background" Value="#251113"/>
        <Setter Property="BorderBrush" Value="#733B38"/>
        <Setter Property="Foreground" Value="#EAA39C"/>
    </Style>

    <Style x:Key="AaaNavTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="#DDD3BD"/>
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="18,13"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="NavRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="#211A10"/>
                            <Setter TargetName="NavRoot" Property="BorderBrush" Value="#8A6B38"/>
                            <Setter Property="Foreground" Value="#F0DFC0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="#12171A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AaaTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="198"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#080D11" BorderBrush="#292A26" BorderThickness="0,0,1,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Bottom" Height="176" Margin="14,4,14,12" BorderBrush="#2B2A24" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Ellipse Width="112" Height="112" Stroke="#7A6034" StrokeThickness="1" Opacity="0.46" VerticalAlignment="Center"/>
                                        <Ellipse Width="74" Height="74" Stroke="#6A5430" StrokeThickness="1" Opacity="0.6" VerticalAlignment="Center"/>
                                        <TextBlock Text="✦" FontSize="47" Foreground="#2C8BD8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#4AA4F0"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TabPanel IsItemsHost="True" Margin="0,12,0,0"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource AaaWindowGradient}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AaaTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0B1116"/>
        <Setter Property="Foreground" Value="{StaticResource AaaTextBrush}"/>
        <Setter Property="BorderBrush" Value="#45423A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="CaretBrush" Value="{StaticResource AaaGoldBrightBrush}"/>
    </Style>

    <Style x:Key="AaaListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AaaTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="AaaProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Foreground" Value="{StaticResource AaaGreenBrush}"/>
        <Setter Property="Background" Value="#1A2224"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
