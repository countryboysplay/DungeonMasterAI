<UserControl x:Class="DungeonMasterAI.App.Views.CombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DungeonMasterAI.App.Controls"
             Background="Transparent"
             Loaded="CombatView_Loaded"
             Unloaded="CombatView_Unloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CombatAmber" Color="#D8AD61"/>
        <SolidColorBrush x:Key="CombatBlue" Color="#63A9E2"/>
        <SolidColorBrush x:Key="CombatGreen" Color="#69B86C"/>
        <SolidColorBrush x:Key="CombatRed" Color="#D76659"/>
        <SolidColorBrush x:Key="CombatPanel" Color="#0A1014"/>
        <SolidColorBrush x:Key="CombatBorder" Color="#4A3C29"/>

        <Style x:Key="CombatHpBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource CombatGreen}"/>
            <Setter Property="Background" Value="#172019"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="CombatTinyLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource AaaMutedBrush}"/>
        </Style>

        <Style x:Key="CombatMetricValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#EFE4CF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CombatActionButton" TargetType="Button" BasedOn="{StaticResource AaaTopButton}">
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="MinWidth" Value="78"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*" MinHeight="275"/>
            <RowDefinition Height="188"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="286"/>
        </Grid.ColumnDefinitions>

        <!-- Combat header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#090E11" BorderBrush="#493C28" BorderThickness="1" CornerRadius="3" Padding="14,7" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AaaVectorIcon Kind="Combat" Width="27" Height="27" Foreground="{StaticResource CombatAmber}" Margin="0,0,11,0"/>
                    <StackPanel>
                        <TextBlock Text="COMBAT" FontFamily="Georgia" FontSize="21" Foreground="#EEE1C7"/>
                        <TextBlock Text="{Binding SelectedEncounter.Name, TargetNullValue=No active encounter}" Style="{StaticResource AaaMuted}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#655233" BorderThickness="1" Background="#11100D" CornerRadius="3" Padding="16,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedEncounter.Round, StringFormat=ROUND {0}}" FontFamily="Georgia" FontSize="15" Foreground="{StaticResource CombatAmber}"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NextCombatTurnCommand}" Style="{StaticResource AaaTopButton}" Padding="12,7" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal"><controls:AaaVectorIcon Kind="Progress" Width="14" Height="14" Foreground="#D6C7AA" Margin="0,0,6,0"/><TextBlock Text="Next Turn" FontFamily="Georgia"/></StackPanel>
                    </Button>
                    <Button Command="{Binding EndEncounterCommand}" Style="{StaticResource AaaDangerButton}" Padding="13,7" Margin="0">
                        <StackPanel Orientation="Horizontal"><controls:AaaVectorIcon Kind="Combat" Width="14" Height="14" Foreground="#EF8C7D" Margin="0,0,6,0"/><TextBlock Text="End Combat" FontFamily="Georgia"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Initiative order -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,6,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="2,0,2,7">
                    <TextBlock Text="INITIATIVE ORDER" Style="{StaticResource AaaSectionTitle}" FontSize="11"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedEncounter.Combatants.Count, StringFormat={}{0} ACTIVE}" Style="{StaticResource AaaMuted}" FontSize="8"/>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedAttacker, Mode=TwoWay}" SelectionChanged="Initiative_SelectionChanged" Style="{StaticResource AaaListBox}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="InitiativeCard" BorderBrush="#282D2E" BorderThickness="0,0,0,1" Padding="4,6" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Border Width="27" Height="27" CornerRadius="14" Background="#151B1D" BorderBrush="#745E3B" BorderThickness="1" VerticalAlignment="Center">
                                        <controls:AaaVectorIcon Kind="Characters" Width="14" Height="14" Foreground="#BDAA83" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="11" Foreground="#E7DDCA" TextTrimming="CharacterEllipsis"/>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Side}" Style="{StaticResource AaaMuted}" FontSize="8"/>
                                            <TextBlock DockPanel.Dock="Right" FontFamily="Georgia" FontSize="8" Foreground="#BDB29D"><Run Text="{Binding CurrentHp}"/><Run Text="/"/><Run Text="{Binding MaxHp}"/></TextBlock>
                                        </DockPanel>
                                        <ProgressBar Maximum="{Binding MaxHp}" Value="{Binding CurrentHp}" Style="{StaticResource CombatHpBar}" Margin="0,3,3,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Initiative}" FontFamily="Georgia" FontSize="17" Foreground="{StaticResource CombatBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActiveTurn}" Value="True">
                                    <Setter TargetName="InitiativeCard" Property="Background" Value="#132232"/>
                                    <Setter TargetName="InitiativeCard" Property="BorderBrush" Value="#315E80"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Dead}" Value="True"><Setter TargetName="InitiativeCard" Property="Opacity" Value="0.42"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Command="{Binding RollInitiativeCommand}" Style="{StaticResource AaaTopButton}" Margin="0,7,0,0" Padding="8,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Dice" Width="13" Height="13" Foreground="{StaticResource CombatAmber}" Margin="0,0,6,0"/><TextBlock Text="Roll Initiative" FontFamily="Georgia" FontSize="10"/></StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Active turn banner -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#091116" BorderBrush="#294B63" BorderThickness="1" CornerRadius="3" Padding="12,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <Border Width="39" Height="39" CornerRadius="20" BorderBrush="#3E83B7" BorderThickness="1" Background="#102335" Margin="0,0,12,0">
                    <controls:AaaVectorIcon Kind="Timeline" Width="21" Height="21" Foreground="{StaticResource CombatBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ACTIVE TURN" FontFamily="Georgia" FontSize="17" Foreground="#E7E0D3"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ActiveTurnName}" FontFamily="Georgia" FontSize="11" Foreground="{StaticResource CombatBlue}"/>
                        <TextBlock Text="  •  Choose an action or target" Style="{StaticResource AaaMuted}" FontSize="9"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="2">
                    <Border Background="#18120B" BorderBrush="#6B542E" BorderThickness="1" CornerRadius="3" Padding="9,5">
                        <StackPanel>
                            <TextBlock Text="PLAYER CONTROL" FontFamily="Georgia" FontSize="9" Foreground="{StaticResource CombatAmber}"/>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource AaaMuted}" FontSize="8.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2A1512" BorderBrush="#9B4C43" BorderThickness="1" CornerRadius="3" Padding="9,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding PlayerRollRequired}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ROLL REQUIRED" FontFamily="Georgia" FontSize="9" Foreground="#F08A7D"/><TextBlock Text="{Binding PendingPlayerRollPrompt}" Style="{StaticResource AaaMuted}" FontSize="8" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Command="{Binding RollD20Command}" Style="{StaticResource AaaDangerButton}" Padding="8,4" Margin="7,0,0,0" Content="Roll"/></Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Tactical battlefield -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AaaPanelBorder}" Padding="0" Margin="0,0,6,0" ClipToBounds="True" BorderBrush="#55452F">
            <Grid>
                <controls:CombatGridControl Campaign="{Binding SelectedCampaign}" Encounter="{Binding SelectedEncounter}" Revision="{Binding MapRevision}" MinHeight="275"/>
                <controls:AaaCombatAtmosphere/>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" Background="#D0080D10">
                    <Button Style="{StaticResource AaaGoldButton}" Width="34" Height="34" Padding="0" Margin="0,0,0,4" ToolTip="Select"><controls:AaaVectorIcon Kind="Location" Width="16" Height="16" Foreground="#E8C67E"/></Button>
                    <Button Style="{StaticResource AaaTopButton}" Width="34" Height="34" Padding="0" Margin="0,0,0,4" ToolTip="Move"><controls:AaaVectorIcon Kind="Speed" Width="16" Height="16" Foreground="#D7CDBA"/></Button>
                    <Button Style="{StaticResource AaaTopButton}" Width="34" Height="34" Padding="0" Margin="0,0,0,4" ToolTip="Target"><controls:AaaVectorIcon Kind="Combat" Width="16" Height="16" Foreground="#D7CDBA"/></Button>
                    <Button Style="{StaticResource AaaTopButton}" Width="34" Height="34" Padding="0" ToolTip="View"><controls:AaaVectorIcon Kind="Maps" Width="16" Height="16" Foreground="#D7CDBA"/></Button>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9" Background="#E0080D10" BorderBrush="#403625" BorderThickness="1" CornerRadius="3" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MOVE TO" Style="{StaticResource AaaMuted}" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding CombatMoveXInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AaaTextBox}" Width="34" Padding="4,2" Margin="0,0,4,0" ToolTip="Grid X"/>
                        <TextBox Text="{Binding CombatMoveYInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AaaTextBox}" Width="34" Padding="4,2" Margin="0,0,6,0" ToolTip="Grid Y"/>
                        <Button Command="{Binding MoveCombatantCommand}" Style="{StaticResource AaaTopButton}" Padding="8,3" Margin="0"><TextBlock Text="Move" FontFamily="Georgia" FontSize="9"/></Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Active combatant panel -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource AaaPanelBorder}" Padding="11" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="ACTIVE COMBATANT" Style="{StaticResource AaaSectionTitle}" FontSize="10"/>
                    <Border Height="1" Background="#3D3528" Margin="0,7,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="4" Background="#171E20" BorderBrush="#7B653F" BorderThickness="1" Margin="0,0,10,0">
                            <controls:AaaVectorIcon Kind="Characters" Width="27" Height="27" Foreground="#BDA77A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedAttacker.Name, TargetNullValue=Select a combatant}" FontFamily="Georgia" FontSize="18" Foreground="{StaticResource CombatBlue}"/>
                            <TextBlock Text="{Binding SelectedAttacker.CharacterType}" Style="{StaticResource AaaMuted}" FontSize="9"/>
                            <TextBlock Text="{Binding SelectedAttacker.Side, StringFormat=Side: {0}}" Style="{StaticResource AaaMuted}" FontSize="8"/>
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <Border BorderBrush="#38332A" BorderThickness="1" Padding="5" Margin="0,0,4,0"><StackPanel><TextBlock Text="AC" Style="{StaticResource CombatTinyLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedAttacker.ArmorClass}" Style="{StaticResource CombatMetricValue}"/></StackPanel></Border>
                        <Border BorderBrush="#38332A" BorderThickness="1" Padding="5" Margin="0,0,4,0"><StackPanel><TextBlock Text="HP" Style="{StaticResource CombatTinyLabel}" HorizontalAlignment="Center"/><TextBlock Style="{StaticResource CombatMetricValue}"><Run Text="{Binding SelectedAttacker.CurrentHp}"/><Run Text="/"/><Run Text="{Binding SelectedAttacker.MaxHp}"/></TextBlock></StackPanel></Border>
                        <Border BorderBrush="#38332A" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="TEMP HP" Style="{StaticResource CombatTinyLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedAttacker.TempHp}" Style="{StaticResource CombatMetricValue}"/></StackPanel></Border>
                    </UniformGrid>
                    <UniformGrid Columns="3" Margin="0,5,0,0">
                        <Border BorderBrush="#302F2B" BorderThickness="1" Padding="5" Margin="0,0,4,0"><StackPanel><TextBlock Text="INITIATIVE" Style="{StaticResource CombatTinyLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedAttacker.Initiative}" Style="{StaticResource CombatMetricValue}" FontSize="13"/></StackPanel></Border>
                        <Border BorderBrush="#302F2B" BorderThickness="1" Padding="5" Margin="0,0,4,0"><StackPanel><TextBlock Text="SPEED" Style="{StaticResource CombatTinyLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedAttacker.Speed, StringFormat={}{0} ft}" Style="{StaticResource CombatMetricValue}" FontSize="13"/></StackPanel></Border>
                        <Border BorderBrush="#302F2B" BorderThickness="1" Padding="5"><StackPanel><TextBlock Text="MOVE LEFT" Style="{StaticResource CombatTinyLabel}" HorizontalAlignment="Center"/><TextBlock Text="{Binding SelectedAttacker.MovementRemainingFeet, StringFormat={}{0} ft}" Style="{StaticResource CombatMetricValue}" FontSize="13"/></StackPanel></Border>
                    </UniformGrid>

                    <TextBlock Text="CONDITIONS" Style="{StaticResource AaaSectionTitle}" FontSize="9" Margin="0,11,0,5"/>
                    <Border Background="#0E1416" BorderBrush="#343631" BorderThickness="1" CornerRadius="3" Padding="8,5"><TextBlock Text="{Binding SelectedAttacker.Conditions}" FontFamily="Georgia" FontSize="9" Foreground="#D1C5AE" TextWrapping="Wrap"/></Border>

                    <TextBlock Text="RESOURCES" Style="{StaticResource AaaSectionTitle}" FontSize="9" Margin="0,10,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                        <DockPanel><Ellipse Width="7" Height="7" Fill="{StaticResource CombatGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Action" FontFamily="Georgia" FontSize="9"/><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedAttacker.ActionAvailable}" Style="{StaticResource AaaMuted}" FontSize="8"/></DockPanel>
                        <DockPanel Grid.Column="1" Margin="10,0,0,0"><Ellipse Width="7" Height="7" Fill="{StaticResource CombatGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Movement" FontFamily="Georgia" FontSize="9"/><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedAttacker.MovementRemainingFeet}" Style="{StaticResource AaaMuted}" FontSize="8"/></DockPanel>
                        <DockPanel Grid.Row="1"><Ellipse Width="7" Height="7" Fill="#D48B42" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Bonus Action" FontFamily="Georgia" FontSize="9"/><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedAttacker.BonusActionAvailable}" Style="{StaticResource AaaMuted}" FontSize="8"/></DockPanel>
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"><Ellipse Width="7" Height="7" Fill="#5A9FBC" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Reaction" FontFamily="Georgia" FontSize="9"/><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedAttacker.ReactionAvailable}" Style="{StaticResource AaaMuted}" FontSize="8"/></DockPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedAttacker.ReadyStatus, StringFormat=Readied: {0}}" Style="{StaticResource AaaMuted}" FontSize="8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom action area -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="ACTIONS" Style="{StaticResource AaaSectionTitle}" FontSize="10"/>
                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,7,0,5">
                        <Button Command="{Binding CombatAttackCommand}" Style="{StaticResource CombatActionButton}" BorderBrush="#315F83" Background="#102131">
                            <StackPanel HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Combat" Width="21" Height="21" Foreground="{StaticResource CombatBlue}" HorizontalAlignment="Center"/><TextBlock Text="Attack" FontFamily="Georgia" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                        <Button Click="CastSpell_Click" Style="{StaticResource CombatActionButton}" BorderBrush="#59447B" Background="#191423">
                            <StackPanel HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Spark" Width="21" Height="21" Foreground="#B18ADA" HorizontalAlignment="Center"/><TextBlock Text="Cast Spell" FontFamily="Georgia" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding TakeDashCommand}" Style="{StaticResource CombatActionButton}" BorderBrush="#4E6334" Background="#141B10">
                            <StackPanel HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Speed" Width="21" Height="21" Foreground="#A8C47B" HorizontalAlignment="Center"/><TextBlock Text="Dash" FontFamily="Georgia" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding TakeDisengageCommand}" Style="{StaticResource CombatActionButton}">
                            <StackPanel HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Progress" Width="21" Height="21" Foreground="#C5A35D" HorizontalAlignment="Center"/><TextBlock Text="Disengage" FontFamily="Georgia" FontSize="8.5" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding TakeDodgeCommand}" Style="{StaticResource CombatActionButton}">
                            <StackPanel HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Shield" Width="21" Height="21" Foreground="#B9C4C8" HorizontalAlignment="Center"/><TextBlock Text="Dodge" FontFamily="Georgia" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                        <Button Command="{Binding HelpAttackCommand}" Style="{StaticResource CombatActionButton}" Margin="0">
                            <StackPanel HorizontalAlignment="Center"><controls:AaaVectorIcon Kind="Characters" Width="21" Height="21" Foreground="#D5B66F" HorizontalAlignment="Center"/><TextBlock Text="Help" FontFamily="Georgia" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </Button>
                    </UniformGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding CombatPreparedSpells}" SelectedItem="{Binding SelectedCombatPreparedSpell, Mode=TwoWay}" DisplayMemberPath="Name" Style="{StaticResource AaaComboBox}" Height="29" ToolTip="Prepared combat spell"/>
                        <TextBox Grid.Column="1" Text="{Binding SpellSlotLevelInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AaaTextBox}" Height="29" Margin="5,0,0,0" ToolTip="Spell slot level"/>
                        <Button Grid.Column="2" Command="{Binding NextCombatTurnCommand}" Style="{StaticResource AaaPrimaryButton}" Padding="11,5" Margin="5,0,0,0"><TextBlock Text="End Turn" FontFamily="Georgia" FontSize="10"/></Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="SELECT A TARGET" Style="{StaticResource AaaSectionTitle}" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTarget.Name}" Style="{StaticResource AaaMuted}" FontSize="8"/></DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" SelectionChanged="Target_SelectionChanged" Style="{StaticResource AaaListBox}" Margin="0,6,0,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TargetCard" Width="82" Height="88" Background="#0D1416" BorderBrush="#5C392F" BorderThickness="1" CornerRadius="3" Margin="0,0,5,5" Padding="5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#171D1F" BorderBrush="#9C4A3F" BorderThickness="1">
                                            <controls:AaaVectorIcon Kind="Characters" Width="20" Height="20" Foreground="#C3A37B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="8.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Width="70" TextAlignment="Center" Margin="0,3,0,1"/>
                                        <TextBlock FontFamily="Georgia" FontSize="8" Foreground="{StaticResource CombatGreen}" HorizontalAlignment="Center"><Run Text="{Binding CurrentHp}"/><Run Text="/"/><Run Text="{Binding MaxHp}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Side}" Value="player"><Setter TargetName="TargetCard" Property="BorderBrush" Value="#3E7447"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Dead}" Value="True"><Setter TargetName="TargetCard" Property="Opacity" Value="0.35"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Select any visible combatant. The deterministic engine validates whether the chosen action and target are legal." Style="{StaticResource AaaMuted}" FontSize="8" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AaaPanelBorder}" Padding="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="COMBAT LOG" Style="{StaticResource AaaSectionTitle}" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding CombatStatus}" Style="{StaticResource AaaMuted}" FontSize="8"/></DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SessionChat}" Style="{StaticResource AaaListBox}" Margin="0,6,0,4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#292C2A" BorderThickness="0,0,0,1" Padding="2,4">
                                    <StackPanel><TextBlock Text="{Binding Speaker}" FontFamily="Georgia" FontSize="8" Foreground="{StaticResource CombatAmber}"/><TextBlock Text="{Binding Content}" FontFamily="Georgia" FontSize="8.5" Foreground="#CFC5B2" TextWrapping="Wrap" MaxHeight="35"/></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Background="#0B1114" BorderBrush="#34342F" BorderThickness="1" CornerRadius="3" Padding="6,4"><TextBlock Text="{Binding StatusMessage}" FontFamily="Georgia" FontSize="8.5" Foreground="#B9CEE0" TextWrapping="Wrap" MaxHeight="30"/></Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
