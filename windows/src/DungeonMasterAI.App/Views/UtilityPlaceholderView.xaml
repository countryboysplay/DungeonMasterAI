<UserControl x:Class="DungeonMasterAI.App.Views.UtilityPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="22">
        <Border Style="{StaticResource AaaPanelBorder}" MaxWidth="940" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="28">
            <StackPanel>
                <TextBlock Text="REDESIGN IN PROGRESS" Style="{StaticResource AaaEyebrow}"/>
                <TextBlock x:Name="TitleText" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource AaaTitle}" Margin="0,7,0,8"/>
                <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource AaaMutedBrush}" FontSize="14" LineHeight="21" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
                <Border Height="1" Background="#3A3328" Margin="0,24,0,18"/>
                <TextBlock Text="The underlying feature remains in the existing deterministic engine while this screen receives the same visual treatment as the four approved reference renders." Foreground="#C4B89E" TextWrapping="Wrap" FontSize="12" LineHeight="19"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
