<UserControl x:Class="DungeonMasterAI.App.Views.CampaignLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!--
        Campaign lifecycle: create, import, AI compile/expand, load sample, save, rehearse, delete.
        Replaces the UtilityPlaceholderView on the Import destination, which left nine commands
        unreachable and broke the ALPHA_ACCEPTANCE criteria covering campaign import and loading
        the bundled Greenhaven sample.
    -->
    <Grid Margin="12,10,12,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Lifecycle actions -->
        <Border Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="14" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="LIBRARY" Style="{StaticResource AaaEyebrow}"/>
                    <TextBlock Text="Campaigns" Style="{StaticResource AaaTitle}" FontSize="24" Margin="0,3,0,12"/>

                    <TextBlock Text="Active campaign" Style="{StaticResource AaaMuted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding SelectedCampaign}"
                              DisplayMemberPath="Name" Style="{StaticResource AaaComboBox}"/>

                    <Border Height="1" Background="#342F28" Margin="0,14,0,12"/>

                    <TextBlock Text="New campaign name" Style="{StaticResource AaaMuted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewCampaignName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AaaTextBox}"/>

                    <Button Command="{Binding CreateCampaignCommand}" Content="✦  Create Campaign"
                            Style="{StaticResource AaaPrimaryButton}" Margin="0,10,0,0"/>

                    <TextBlock Text="IMPORT SOURCE MATERIAL" Style="{StaticResource AaaSectionTitle}" Margin="0,18,0,8"/>
                    <Button Command="{Binding ImportCampaignCommand}" Content="⭳  Quick Import" Style="{StaticResource AaaTopButton}" Margin="0,0,0,5"/>
                    <Button Command="{Binding CompileCampaignWithAiCommand}" Content="⚙  AI Compile File" Style="{StaticResource AaaTopButton}" Margin="0,0,0,5"/>
                    <Button Command="{Binding ExpandCampaignWithAiCommand}" Content="✧  Expand Missing Content" Style="{StaticResource AaaTopButton}" Margin="0,0,0,5"/>
                    <Button Command="{Binding LoadSampleCommand}" Content="▤  Load Greenhaven Sample" Style="{StaticResource AaaGoldButton}" Margin="0,0,0,5"/>

                    <TextBlock Style="{StaticResource AaaMuted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="16"
                               Text="Quick Import reads JSON or falls back to heuristic extraction. AI Compile File extracts source canon first, then adds separately marked AI-expanded detail needed for play. Expand Missing Content reruns only that second stage."/>

                    <TextBlock Text="MAINTENANCE" Style="{StaticResource AaaSectionTitle}" Margin="0,18,0,8"/>
                    <Button Command="{Binding SaveCommand}" Content="◆  Save" Style="{StaticResource AaaGoldButton}" Margin="0,0,0,5"/>
                    <Button Command="{Binding RunRehearsalCommand}" Content="⟳  Run Rehearsal" Style="{StaticResource AaaTopButton}" Margin="0,0,0,5"/>
                    <Button Command="{Binding DeleteCampaignCommand}" Content="⊗  Delete Campaign" Style="{StaticResource AaaDangerButton}" Margin="0,0,0,5"/>

                    <TextBlock Text="{Binding CampaignCompilerStatus}" Foreground="{StaticResource AaaGoldBrightBrush}"
                               TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Overview, readiness, rehearsal, merchant probe -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource AaaPanelBorder}" Padding="16" Margin="0,0,0,7">
                    <StackPanel>
                        <TextBlock Text="CAMPAIGN OVERVIEW" Style="{StaticResource AaaSectionTitle}"/>
                        <TextBlock Text="{Binding SelectedCampaign.Name, TargetNullValue=No campaign selected}"
                                   Style="{StaticResource AaaTitle}" FontSize="21" Margin="0,7,0,0"/>
                        <TextBlock Text="{Binding SelectedCampaign.System}" Style="{StaticResource AaaMuted}" Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding SelectedCampaign.Summary}" TextWrapping="Wrap" FontFamily="Georgia"
                                   FontSize="12" LineHeight="19" Foreground="#D5CEBF"/>
                        <TextBlock Text="{Binding SelectedCampaign.Tone}" Style="{StaticResource AaaMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AaaPanelBorder}" Padding="16" Margin="0,0,0,7">
                    <StackPanel>
                        <TextBlock Text="CAMPAIGN READINESS" Style="{StaticResource AaaSectionTitle}"/>
                        <TextBlock Text="{Binding ReadinessSummary}" FontFamily="Georgia" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ExpansionSummary}" Foreground="{StaticResource AaaGoldBrush}"
                                   TextWrapping="Wrap" FontSize="11" Margin="0,5,0,8"/>
                        <ItemsControl ItemsSource="{Binding ReadinessIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AaaBorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock FontFamily="Georgia" FontSize="11">
                                                <Run Foreground="{StaticResource AaaGoldBrightBrush}" Text="{Binding Severity, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Category, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource AaaMuted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AaaPanelBorder}" Padding="16" Margin="0,0,0,7">
                    <StackPanel>
                        <TextBlock Text="CAMPAIGN REHEARSAL" Style="{StaticResource AaaSectionTitle}"/>
                        <TextBlock Text="{Binding RehearsalSummary}" FontFamily="Georgia" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource AaaMuted}" TextWrapping="Wrap" Margin="0,5,0,8" LineHeight="16"
                                   Text="Deterministic pre-play probes check travel reachability, ambiguous keys, merchant transactions, encounter readiness, tactical map integrity, secret leakage, timeline drift, and generated-detail references."/>
                        <ItemsControl ItemsSource="{Binding RehearsalFindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AaaBorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel>
                                            <TextBlock FontFamily="Georgia" FontSize="11">
                                                <Run Foreground="{StaticResource AaaGoldBrightBrush}" Text="{Binding Severity, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Scenario, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource AaaMuted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AaaPanelBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MERCHANT TEST" Style="{StaticResource AaaSectionTitle}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Merchant" Style="{StaticResource AaaMuted}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Merchants}" SelectedItem="{Binding SelectedMerchant}"
                                          DisplayMemberPath="Name" Style="{StaticResource AaaComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock" Style="{StaticResource AaaMuted}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SelectedMerchantStock}" SelectedItem="{Binding SelectedStock}"
                                          DisplayMemberPath="ItemId" Style="{StaticResource AaaComboBox}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource AaaMuted}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Select a character on the Characters destination, then buy one unit. Gold, stock, and inventory update together in a single deterministic transaction."/>
                        <Button Command="{Binding BuySelectedItemCommand}" Content="◉  Buy Selected Item"
                                Style="{StaticResource AaaGoldButton}" HorizontalAlignment="Left" MinWidth="190" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
