<UserControl x:Class="DungeonMasterAI.App.Views.QuestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="1536" d:DesignHeight="720">
    <!--
        Quests, factions, secrets, and the world timeline.

        The shell previously pointed its Quests tab at WorldView, so this tab was a duplicate of
        the World tab and the quest journal, objective lists, DM notes, secret truths, and
        timeline consequences had no home in the shell at all. This view owns that content.
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="196"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="392"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource AaaPanelBorder}" Padding="15,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QUESTS / FACTIONS / SECRETS" Style="{StaticResource AaaEyebrow}"/>
                    <TextBlock Text="The Quest Journal" Style="{StaticResource AaaTitle}" FontSize="24" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Width="120">
                        <TextBlock Text="Campaign" Style="{StaticResource AaaMuted}"/>
                        <TextBlock Text="{Binding SelectedCampaign.Name, TargetNullValue=No campaign loaded}"
                                   FontFamily="Georgia" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="Campaign Time" Style="{StaticResource AaaMuted}"/>
                        <TextBlock Text="{Binding CampaignTime}" FontFamily="Georgia" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quest journal -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="12" Margin="0,0,8,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource AaaMuted}" VerticalAlignment="Center">
                        <Run Text="{Binding Quests.Count, Mode=OneWay, FallbackValue=0}"/><Run Text=" tracked"/>
                    </TextBlock>
                    <TextBlock Text="QUEST JOURNAL" Style="{StaticResource AaaSectionTitle}"/>
                    
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Quests}" Style="{StaticResource AaaListBox}"
                         Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0D1316" BorderBrush="#39332A" BorderThickness="1" CornerRadius="3"
                                    Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="♜" Foreground="{StaticResource AaaGoldBrush}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                                   Foreground="{StaticResource AaaGreenBrush}" FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource AaaMuted}" FontSize="10"
                                               TextWrapping="Wrap" Margin="21,4,0,0"/>

                                    <ItemsControl ItemsSource="{Binding Objectives}" Margin="21,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock Text="◇" Foreground="#8D7C5D" FontSize="9" Width="16"/>
                                                    <TextBlock Text="{Binding}" FontSize="9.5" Foreground="#CFC5B2" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <DockPanel Margin="21,7,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding SourceKind}"
                                                   Style="{StaticResource AaaMuted}" FontSize="8.5"/>
                                        <TextBlock Text="{Binding RewardGp, StringFormat=Reward: {0} gp}"
                                                   Foreground="#D0A959" FontSize="9"/>
                                        
                                    </DockPanel>

                                    <!-- DM-only notes stay visually distinct from player-facing text. -->
                                    <Border Background="#160F0F" BorderBrush="#5E3B36" BorderThickness="1" CornerRadius="3"
                                            Padding="7,5" Margin="21,7,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DmNotes}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="DM NOTES" Foreground="#C8837A" FontFamily="Georgia" FontSize="8"/>
                                            <TextBlock Text="{Binding DmNotes}" Foreground="#C3B7A4" FontSize="9"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Factions and secrets -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AaaPanelBorder}" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="FACTIONS" Style="{StaticResource AaaSectionTitle}" Foreground="#6D9FD4"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FactionDisplays}" Style="{StaticResource AaaListBox}"
                             Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#272D30" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Knowledge}"
                                                       Foreground="#D0A959" FontSize="8.5"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="10.5"/>
                                            
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource AaaMuted}"
                                                   FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AaaPanelBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="DM only" Style="{StaticResource AaaMuted}" FontSize="8.5"/>
                        <TextBlock Text="SECRETS" Style="{StaticResource AaaSectionTitle}" Foreground="#6D9FD4"/>
                        
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SecretDisplays}" Style="{StaticResource AaaListBox}"
                             Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#272D30" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="◉" Foreground="#8D7C5D" Width="17" FontSize="9"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Revealed, StringFormat=Revealed: {0}}"
                                                       Style="{StaticResource AaaMuted}" FontSize="8"/>
                                            <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Truth}" Foreground="#C3B7A4" FontSize="9"
                                                   TextWrapping="Wrap" Margin="17,3,0,0"/>
                                        <TextBlock Text="{Binding RevealConditions, StringFormat=Reveals when: {0}}"
                                                   Style="{StaticResource AaaMuted}" FontSize="8.5"
                                                   TextWrapping="Wrap" Margin="17,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Timeline -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource AaaPanelBorder}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="WORLD TIMELINE" Style="{StaticResource AaaSectionTitle}"/>
                    <TextBlock Style="{StaticResource AaaMuted}" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Run Text="TODAY:  "/><Run Text="{Binding CampaignTime, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,9,0,0">
                    <ItemsControl ItemsSource="{Binding TimelineDisplays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#11161A" BorderBrush="#4C4030" BorderThickness="1" CornerRadius="3"
                                        Margin="0,0,7,0" Padding="10,8" Width="212">
                                    <StackPanel>
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Resolved, StringFormat=Resolved: {0}}"
                                                       Style="{StaticResource AaaMuted}" FontSize="8"/>
                                            <TextBlock Text="{Binding Schedule}" FontFamily="Georgia"
                                                       Foreground="#DCC792" FontSize="10"/>
                                            
                                        </DockPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="10.5"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Consequence}" Style="{StaticResource AaaMuted}"
                                                   FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
