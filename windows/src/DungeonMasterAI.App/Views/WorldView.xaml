<UserControl x:Class="DungeonMasterAI.App.Views.WorldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DungeonMasterAI.App.Controls"
             Background="Transparent">
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="304"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="0" Margin="0,0,8,8" ClipToBounds="True">
            <Grid>
                <controls:CampaignMapControl Campaign="{Binding SelectedCampaign}" ShowDmView="{Binding ShowDmMap}" Revision="{Binding MapRevision}" SelectedLocation="{Binding SelectedLocation, Mode=TwoWay}"/>
                <Grid VerticalAlignment="Top" Margin="18,14,18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="WORLD / MAPS / QUESTS" Style="{StaticResource AaaEyebrow}"/>
                        <TextBlock Text="The Eldenwild" Style="{StaticResource AaaTitle}" FontSize="27" Margin="0,3,0,0"/>
                        <TextBlock Text="A land of ancient forests, forgotten ruins, and whispers older than memory." FontFamily="Georgia" FontSize="11" Foreground="#D0C5AF" MaxWidth="300" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#D8070B0E" BorderBrush="#3B3B34" BorderThickness="1" CornerRadius="15" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="PLAYER VIEW" GroupName="MapMode" Foreground="#B8B3AA" Padding="15,5"/>
                            <RadioButton Content="DM VIEW" GroupName="MapMode" IsChecked="{Binding ShowDmMap}" Foreground="#D9E4EF" Background="#15324A" Padding="15,5"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#D8070B0E" BorderBrush="#3B3B34" BorderThickness="1" CornerRadius="3" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● Ping" Margin="0,0,13,0" FontSize="10"/>
                            <TextBlock Text="◉ Reveal" Margin="0,0,13,0" FontSize="10"/>
                            <TextBlock Text="⊘ Hide" Margin="0,0,13,0" FontSize="10"/>
                            <TextBlock Text="▽ Filter" Margin="0,0,13,0" FontSize="10"/>
                            <TextBlock Text="▣ Add Note" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,65,0,0" Width="118" Background="#E0080D11" BorderBrush="#5B4930" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Text="◇ LEGEND" Style="{StaticResource AaaSectionTitle}" FontSize="10"/>
                        <Border Height="1" Background="#4C402E" Margin="0,8"/>
                        <TextBlock Text="⊙  You Are Here" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="♜  City / Town" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="⌂  Settlement" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="?  Point of Interest" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="♟  Dungeon" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="▥  Ruins" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="—  Road" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="···  Path" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="≈  River" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="◌  Hidden Area" FontSize="9" Margin="0,3"/>
                        <TextBlock Text="?  Undiscovered" FontSize="9" Margin="0,3"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="250" Background="#F20A1116" BorderBrush="#7B6137" BorderThickness="1" CornerRadius="3" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel><TextBlock Text="{Binding SelectedLocation.Name, TargetNullValue=GREENHAVEN}" FontFamily="Georgia" FontSize="17" Foreground="#E1C27B"/><TextBlock DockPanel.Dock="Right" Text="×" Foreground="#B9B1A2"/></DockPanel>
                        <TextBlock Text="{Binding SelectedLocation.Type, TargetNullValue=Peaceful Riverside Town}" FontFamily="Georgia" FontSize="10" Foreground="#C9C0AD"/>
                        <Border Height="86" Background="#1D262A" BorderBrush="#3D3B34" BorderThickness="1" Margin="0,8,0,8"><TextBlock Text="♜" FontSize="49" Foreground="#73684F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{Binding SelectedLocation.Description}" TextWrapping="Wrap" FontSize="9.5" Foreground="#D0C7B6" LineHeight="14"/>
                        <TextBlock Text="DISCOVERED CONNECTIONS" Style="{StaticResource AaaMuted}" Foreground="#CBA75B" FontSize="8" Margin="0,8,0,4"/>
                        <WrapPanel><Border Background="#12191D" BorderBrush="#393832" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,4,0"><TextBlock Text="Elderwood" FontSize="8"/></Border><Border Background="#12191D" BorderBrush="#393832" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,4,0"><TextBlock Text="The Old Road" FontSize="8"/></Border><Border Background="#12191D" BorderBrush="#393832" BorderThickness="1" CornerRadius="8" Padding="8,3"><TextBlock Text="Ravenmere" FontSize="8"/></Border></WrapPanel>
                        <TextBlock Text="READINESS &amp; ENCOUNTERS" Style="{StaticResource AaaMuted}" Foreground="#CBA75B" FontSize="8" Margin="0,8,0,4"/>
                        <DockPanel><TextBlock Text="Settlement Readiness" FontSize="8"/><TextBlock DockPanel.Dock="Right" Text="Prepared  ▮▮▮▮▮" Foreground="{StaticResource AaaGreenBrush}" FontSize="8"/></DockPanel>

                        <!--
                            Location actions. Both commands act on SelectedLocation, which the map
                            control sets. The picker gives a keyboard-reachable alternative to
                            clicking a pin, and keeps both commands reachable when no pin is chosen.
                        -->
                        <Border Height="1" Background="#4C402E" Margin="0,9,0,7"/>
                        <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" DisplayMemberPath="Name" Style="{StaticResource AaaComboBox}" Height="26" FontSize="9" ToolTip="Jump to a known location"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding RevealLocationCommand}" Content="Reveal Location" Style="{StaticResource AaaTopButton}" Padding="6,4" Margin="0" FontSize="9" ToolTip="Reveal this location to the players"/>
                            <Button Grid.Column="2" Command="{Binding MovePartyCommand}" Content="Move Party Here" Style="{StaticResource AaaPrimaryButton}" Padding="6,4" Margin="0" FontSize="9" ToolTip="Travel the party to this location"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
            <Border Style="{StaticResource AaaPanelBorder}" Padding="11" Margin="0,0,0,6" Height="210">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="CURRENT QUESTS" Style="{StaticResource AaaSectionTitle}" Foreground="#7DA8D7"/><TextBlock DockPanel.Dock="Right" Text="View All  ›" Style="{StaticResource AaaMuted}"/></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding Quests}" Style="{StaticResource AaaListBox}" Margin="0,6,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#272D30" BorderThickness="0,0,0,1" Padding="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♜" Foreground="{StaticResource AaaGoldBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="9.5"/><TextBlock Text="{Binding Summary}" Style="{StaticResource AaaMuted}" FontSize="7.5" TextWrapping="Wrap" MaxHeight="23"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource AaaGreenBrush}" FontSize="8" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
            </Border>
            <Border Style="{StaticResource AaaPanelBorder}" Padding="11" Margin="0,0,0,6" Height="176">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="FACTIONS" Style="{StaticResource AaaSectionTitle}" Foreground="#6D9FD4"/><TextBlock DockPanel.Dock="Right" Text="View All  ›" Style="{StaticResource AaaMuted}"/></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding FactionDisplays}" Style="{StaticResource AaaListBox}" Margin="0,5,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#272D30" BorderThickness="0,0,0,1" Padding="0,5"><StackPanel><DockPanel><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="9.5"/><TextBlock DockPanel.Dock="Right" Text="{Binding Knowledge}" Foreground="#D0A959" FontSize="8"/></DockPanel><TextBlock Text="{Binding Summary}" Style="{StaticResource AaaMuted}" FontSize="7.5" TextTrimming="CharacterEllipsis"/><ProgressBar Style="{StaticResource AaaProgress}" Value="62" Maximum="100" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
            </Border>
            <Border Style="{StaticResource AaaPanelBorder}" Padding="11" Margin="0,0,0,6" Height="115"><StackPanel><TextBlock Text="RUMORS" Style="{StaticResource AaaSectionTitle}" Foreground="#6D9FD4"/><TextBlock Text="◉  Strange lights seen in the Eldenwood at night.             High" FontSize="8.5" Margin="0,7,0,3"/><TextBlock Text="◉  Bandits have been sighted near Stonebridge.             Medium" FontSize="8.5" Margin="0,3"/><TextBlock Text="◉  A hidden stash somewhere in Mistmoor.                       Low" FontSize="8.5" Margin="0,3"/></StackPanel></Border>
            <Border Style="{StaticResource AaaPanelBorder}" Padding="11" Height="112"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SECRETS  ◉" Style="{StaticResource AaaSectionTitle}" Foreground="#6D9FD4"/><ListBox Grid.Row="1" ItemsSource="{Binding SecretDisplays}" Style="{StaticResource AaaListBox}" Margin="0,5,0,0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="◉" Foreground="#8D7C5D" Width="17"/><TextBlock Text="{Binding Title}" FontSize="8.2" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="🔒" FontSize="7"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="10" Margin="0,0,8,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="WORLD TIMELINE" Style="{StaticResource AaaSectionTitle}"/><TextBlock Style="{StaticResource AaaMuted}" Margin="18,0,0,0"><Run Text="TODAY:  "/><Run Text="{Binding CampaignTime, Mode=OneWay}"/></TextBlock><Button DockPanel.Dock="Right" Content="Go to Date  ▣" Style="{StaticResource AaaTopButton}" Padding="8,3" Margin="0"/></DockPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding TimelineDisplays}" Margin="0,11,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#11161A" BorderBrush="#4C4030" BorderThickness="1" CornerRadius="3" Margin="3" Padding="7"><StackPanel><TextBlock Text="{Binding Schedule}" FontFamily="Georgia" Foreground="#DCC792" HorizontalAlignment="Center" FontSize="10"/><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="8.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AaaPanelBorder}" Padding="10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="QUEST TRACKER" Style="{StaticResource AaaSectionTitle}"/><TextBlock DockPanel.Dock="Right" Text="4 Active" Foreground="#D8B66C" FontSize="9"/></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding Quests}" Style="{StaticResource AaaListBox}" Margin="0,7,0,0"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#272D30" BorderThickness="0,0,0,1" Padding="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="9.5"/><TextBlock Text="{Binding Summary}" Style="{StaticResource AaaMuted}" FontSize="7.5" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="40%" FontSize="8"/><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource AaaGreenBrush}" FontSize="7.5"/></DockPanel><ProgressBar Style="{StaticResource AaaProgress}" Value="40" Maximum="100" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
        </Border>
    </Grid>
</UserControl>
