<UserControl x:Class="DungeonMasterAI.App.Views.CharactersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="12,10,12,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="300"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Hero character header -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Padding="0" Margin="0,0,8,8" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#15191A" BorderBrush="#4E402B" BorderThickness="0,0,1,0">
                    <Grid>
                        <Ellipse Width="190" Height="190" Fill="#202A2D" Stroke="#A1844B" StrokeThickness="2" VerticalAlignment="Top" Margin="0,20,0,0"/>
                        <TextBlock Text="♛" FontSize="118" Foreground="#7D7567" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        <Border Width="58" Height="58" Background="#15130F" BorderBrush="#A28149" BorderThickness="2" CornerRadius="29" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15"><TextBlock Text="✦" FontSize="27" Foreground="{StaticResource AaaGoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="24,18,22,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCharacter.Name, TargetNullValue=Aeliana Lightbringer}" Style="{StaticResource AaaTitle}" FontSize="28"/>
                            <TextBlock FontFamily="Georgia" FontSize="13" Margin="0,4,0,0"><Run Text="{Binding SelectedCharacter.CharacterType, TargetNullValue=Human}"/><Run Text="  •  "/><Run Foreground="{StaticResource AaaGoldBrush}" Text="Level "/><Run Foreground="{StaticResource AaaGoldBrush}" Text="{Binding SelectedCharacter.Level}"/></TextBlock>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Edit Character" Style="{StaticResource AaaTopButton}" VerticalAlignment="Top"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,13,0,8"><TextBlock Text="Level" Style="{StaticResource AaaMuted}"/><TextBlock Text="{Binding SelectedCharacter.Level}" Foreground="{StaticResource AaaGoldBrightBrush}" Margin="6,0,0,0"/><ProgressBar Width="240" Height="4" Value="38" Maximum="100" Style="{StaticResource AaaProgress}" Margin="12,8,0,0"/><TextBlock DockPanel.Dock="Right" Text="2,450 / 6,500 XP" Style="{StaticResource AaaMuted}"/></DockPanel>
                    <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,8">
                        <Border Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="♡" FontSize="19" Foreground="#C9BBA2"/><StackPanel Margin="9,0,0,0"><TextBlock FontFamily="Georgia" FontSize="17"><Run Text="{Binding SelectedCharacter.CurrentHp}"/><Run Text=" / "/><Run Text="{Binding SelectedCharacter.MaxHp}"/></TextBlock><TextBlock Text="HP" Style="{StaticResource AaaMuted}" FontSize="9"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="19"/><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding SelectedCharacter.ArmorClass}" FontFamily="Georgia" FontSize="17"/><TextBlock Text="AC" Style="{StaticResource AaaMuted}" FontSize="9"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="♞" FontSize="19"/><StackPanel Margin="9,0,0,0"><TextBlock FontFamily="Georgia" FontSize="17"><Run Text="{Binding SelectedCharacter.Speed}"/><Run Text=" ft."/></TextBlock><TextBlock Text="Speed" Style="{StaticResource AaaMuted}" FontSize="9"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource AaaPanelBorder}" Padding="9" Margin="0,0,4,0"><StackPanel Orientation="Horizontal"><TextBlock Text="⚔" FontSize="18"/><StackPanel Margin="9,0,0,0"><TextBlock Text="—" FontFamily="Georgia" FontSize="17"/><TextBlock Text="Initiative" Style="{StaticResource AaaMuted}" FontSize="9"/></StackPanel></StackPanel></Border>
                        <Border Style="{StaticResource AaaPanelBorder}" Padding="9"><StackPanel Orientation="Horizontal"><TextBlock Text="✣" FontSize="18"/><StackPanel Margin="9,0,0,0"><TextBlock Text="—" FontFamily="Georgia" FontSize="17"/><TextBlock Text="Spell Save DC" Style="{StaticResource AaaMuted}" FontSize="9"/></StackPanel></StackPanel></Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="3" Columns="6" Margin="12,0,12,5">
                        <Border BorderBrush="#4A4030" BorderThickness="1" CornerRadius="2" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Center"><TextBlock Text="STR" Style="{StaticResource AaaMuted}" FontSize="9"/><TextBlock Text="{Binding SelectedCharacter.Abilities[strength], TargetNullValue=10}" FontFamily="Georgia" FontSize="18"/></StackPanel></Border>
                        <Border BorderBrush="#4A4030" BorderThickness="1" CornerRadius="2" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Center"><TextBlock Text="DEX" Style="{StaticResource AaaMuted}" FontSize="9"/><TextBlock Text="{Binding SelectedCharacter.Abilities[dexterity], TargetNullValue=10}" FontFamily="Georgia" FontSize="18"/></StackPanel></Border>
                        <Border BorderBrush="#4A4030" BorderThickness="1" CornerRadius="2" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Center"><TextBlock Text="CON" Style="{StaticResource AaaMuted}" FontSize="9"/><TextBlock Text="{Binding SelectedCharacter.Abilities[constitution], TargetNullValue=10}" FontFamily="Georgia" FontSize="18"/></StackPanel></Border>
                        <Border BorderBrush="#4A4030" BorderThickness="1" CornerRadius="2" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Center"><TextBlock Text="INT" Style="{StaticResource AaaMuted}" FontSize="9"/><TextBlock Text="{Binding SelectedCharacter.Abilities[intelligence], TargetNullValue=10}" FontFamily="Georgia" FontSize="18"/></StackPanel></Border>
                        <Border BorderBrush="#4A4030" BorderThickness="1" CornerRadius="2" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Center"><TextBlock Text="WIS" Style="{StaticResource AaaMuted}" FontSize="9"/><TextBlock Text="{Binding SelectedCharacter.Abilities[wisdom], TargetNullValue=10}" FontFamily="Georgia" FontSize="18"/></StackPanel></Border>
                        <Border BorderBrush="#4A4030" BorderThickness="1" CornerRadius="2" Padding="5" Margin="2"><StackPanel HorizontalAlignment="Center"><TextBlock Text="CHA" Style="{StaticResource AaaMuted}" FontSize="9"/><TextBlock Text="{Binding SelectedCharacter.Abilities[charisma], TargetNullValue=10}" FontFamily="Georgia" FontSize="18"/></StackPanel></Border>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- Party roster -->
        <Border Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource AaaPanelBorder}" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="PARTY (4 / 4)" Style="{StaticResource AaaSectionTitle}"/><Button DockPanel.Dock="Right" Content="Manage Party" Style="{StaticResource AaaTopButton}" Padding="9,5" Margin="0"/></DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" Style="{StaticResource AaaListBox}" Margin="0,10,0,8">
                    <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#3B352A" BorderThickness="1" Background="#0C1216" CornerRadius="3" Padding="7" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="68" Height="82" Background="#171E20" BorderBrush="#6A5637" BorderThickness="1"><TextBlock Text="♟" FontSize="44" Foreground="#817665" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,1,0,0"><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="13" TextWrapping="Wrap"/><TextBlock FontFamily="Georgia" FontSize="10" Foreground="#B6AF9F" Margin="0,3,0,5"><Run Text="Level "/><Run Text="{Binding Level}"/></TextBlock><TextBlock FontSize="10" Foreground="#C7CFBD"><Run Text="{Binding CurrentHp}"/><Run Text=" / "/><Run Text="{Binding MaxHp}"/><Run Text=" HP"/></TextBlock><ProgressBar Value="{Binding CurrentHp}" Maximum="{Binding MaxHp}" Style="{StaticResource AaaProgress}" Margin="0,2,0,7"/><TextBlock Text="Frontline • Support • Utility" Style="{StaticResource AaaMuted}" FontSize="9"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <!-- Party-scoped recovery. Previously decorative; now bound to the deterministic rest commands. -->
                <StackPanel Grid.Row="2">
                    <Button Command="{Binding ShortRestCommand}" Content="♙  Short Rest" Style="{StaticResource AaaGoldButton}" Margin="0"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding LongRestCommand}" Content="☾  Long Rest" Style="{StaticResource AaaTopButton}" Margin="0"/>
                        <Button Grid.Column="2" Command="{Binding SpendHitDieCommand}" Content="⬡  Hit Die" Style="{StaticResource AaaTopButton}" Margin="0"/>
                    </Grid>
                    <Button Command="{Binding AddQuickCharacterCommand}" Content="＋  Add Test Character" Style="{StaticResource AaaTopButton}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Character details -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#3A3328" BorderThickness="1" Background="#0B1014" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#211A10" BorderBrush="#8A6B38" BorderThickness="0,0,0,2" Padding="18,10"><TextBlock Text="▣ Overview" FontFamily="Georgia" Foreground="#E8D8B7"/></Border>
                    <TextBlock Text="♟ Inventory" FontFamily="Georgia" Foreground="#AEA697" Margin="22,0" VerticalAlignment="Center"/>
                    <TextBlock Text="✣ Spells" FontFamily="Georgia" Foreground="#AEA697" Margin="22,0" VerticalAlignment="Center"/>
                    <TextBlock Text="✥ Conditions" FontFamily="Georgia" Foreground="#AEA697" Margin="22,0" VerticalAlignment="Center"/>
                    <TextBlock Text="▥ Journal" FontFamily="Georgia" Foreground="#AEA697" Margin="22,0" VerticalAlignment="Center"/>
                    <TextBlock Text="♜ Progression" FontFamily="Georgia" Foreground="#AEA697" Margin="22,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="0.78*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AaaPanelBorder}" Margin="0,0,6,0" Padding="12">
                    <StackPanel><DockPanel><TextBlock Text="INVENTORY" Style="{StaticResource AaaSectionTitle}"/><TextBlock DockPanel.Dock="Right" Text="Encumbrance" Style="{StaticResource AaaMuted}"/></DockPanel><TextBlock Text="WEAPONS &amp; ARMOR" Style="{StaticResource AaaMuted}" Foreground="#D7C48D" Margin="0,12,0,6"/><ItemsControl ItemsSource="{Binding SelectedCharacter.Inventory}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="58" Height="58" Background="#12191D" BorderBrush="#4B4435" BorderThickness="1" CornerRadius="3" Margin="0,0,6,6"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◆" FontSize="19" Foreground="#C39B58" HorizontalAlignment="Center"/><TextBlock Text="{Binding ItemId}" FontSize="8" TextTrimming="CharacterEllipsis" Width="50" TextAlignment="Center"/><TextBlock Text="{Binding Quantity, StringFormat=x{0}}" FontSize="8" Foreground="#AFA798" HorizontalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Height="1" Background="#342F28" Margin="0,12,0,10"/><TextBlock Text="GOLD" Style="{StaticResource AaaMuted}" Foreground="#D7C48D"/><TextBlock FontFamily="Georgia" FontSize="17" Foreground="#E0B75F" Margin="0,6,0,0"><Run Text="◉  "/><Run Text="{Binding SelectedCharacter.Gold}"/></TextBlock></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AaaPanelBorder}" Margin="0,0,6,0" Padding="12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="SPELLS" Style="{StaticResource AaaSectionTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="CONCENTRATION  " Style="{StaticResource AaaMuted}"/><TextBlock Text="{Binding SelectedCharacter.ConcentrationEffect, TargetNullValue=None}" FontFamily="Georgia" Foreground="#D5C290"/></StackPanel></DockPanel><StackPanel Grid.Row="1" Margin="0,10,0,8"><TextBlock Text="SPELL SLOTS" Style="{StaticResource AaaMuted}" Foreground="#D7C48D"/><TextBlock Text="{Binding SpellSlotsSummary}" Foreground="#69A9E3" FontSize="11" Margin="0,4,0,0"/></StackPanel><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding PreparedSpells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="88" Height="74" Background="#11191D" BorderBrush="#5A4930" BorderThickness="1" CornerRadius="3" Margin="0,0,7,7"><StackPanel VerticalAlignment="Center"><TextBlock Text="✦" FontSize="27" Foreground="#E4BC53" HorizontalAlignment="Center"/><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="9" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource AaaPanelBorder}" Padding="11" Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="ACTIVE EFFECTS" Style="{StaticResource AaaSectionTitle}"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AaaMuted}" FontSize="9">
                                    <Run Text="Exhaustion "/><Run Text="{Binding SelectedCharacter.ExhaustionLevel, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedCharacterConditions}" Style="{StaticResource AaaMuted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding SelectedCharacterOngoingEffects}" FontFamily="Georgia" FontSize="9.5" Foreground="#C9D3C0" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <Border Height="1" Background="#342F28" Margin="0,9,0,7"/>
                            <TextBlock Text="CONCENTRATION" Style="{StaticResource AaaMuted}" Foreground="#D7C48D" FontSize="9"/>
                            <TextBlock Text="{Binding SelectedCharacterConcentration}" FontFamily="Georgia" FontSize="10" Foreground="#D5C290" TextWrapping="Wrap" Margin="0,4,0,6"/>
                            <TextBox Text="{Binding ConcentrationEffectInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AaaTextBox}" FontSize="10" ToolTip="Effect to concentrate on"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding BeginConcentrationCommand}" Content="Begin" Style="{StaticResource AaaTopButton}" Margin="0" FontSize="10"/>
                                <Button Grid.Column="2" Command="{Binding EndConcentrationCommand}" Content="End" Style="{StaticResource AaaTopButton}" Margin="0" FontSize="10" MinWidth="56"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AaaPanelBorder}" Padding="11" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="DEATH SAVES" Style="{StaticResource AaaSectionTitle}"/>
                            <TextBlock Text="{Binding SelectedCharacterDeathSaves}" FontFamily="Georgia" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Button Command="{Binding DeathSaveCommand}" Content="☠  Roll Death Save" Style="{StaticResource AaaDangerButton}" Margin="0,8,0,0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <!-- Vitals adjustment. Fixed-step deterministic probes, matching the reference surface. -->
                    <Border Style="{StaticResource AaaPanelBorder}" Padding="11">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="VITALS" Style="{StaticResource AaaSectionTitle}"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AaaMuted}" FontSize="9">
                                    <Run Text="Temp "/><Run Foreground="#7DBE87" Text="{Binding SelectedCharacter.TempHp, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource AaaMuted}" FontSize="9" Margin="0,6,0,7">
                                <Run Text="Effective speed "/><Run Text="{Binding SelectedCharacterEffectiveSpeed, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Command="{Binding DamageCharacterCommand}" Content="▼  Take 1 Damage" Style="{StaticResource AaaTopButton}" Margin="0,0,0,5" FontSize="10"/>
                            <Button Command="{Binding HealCharacterCommand}" Content="▲  Heal 1" Style="{StaticResource AaaTopButton}" Margin="0,0,0,5" FontSize="10"/>
                            <Button Command="{Binding GrantTempHpCommand}" Content="✚  Grant 5 Temp HP" Style="{StaticResource AaaTopButton}" Margin="0" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
