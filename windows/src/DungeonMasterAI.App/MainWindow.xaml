<Window x:Class="DungeonMasterAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DungeonMasterAI.App.Controls"
        Title="Dungeon Master AI" Width="1500" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" TabStripPlacement="Left" Margin="0">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,28,30,34" MaxWidth="1480">
                        <DockPanel Margin="4,0,4,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Eyebrow}" Text="COMMAND CENTER"/>
                                <TextBlock Style="{StaticResource Title}" Text="Dungeon Master AI" Margin="0,5,0,4"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13" Text="Run the rules, world state, campaign memory, and local AI from one table."/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#101720" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="20,4,0,0" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="LOCAL ENGINE READY"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <Border Style="{StaticResource HeroCard}" Margin="4,0,4,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.55*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource GoldBrush}" Text="CURRENT TABLE"/>
                                    <TextBlock FontSize="31" FontWeight="SemiBold" Margin="0,7,0,6" Text="{Binding SelectedCampaign.Name, TargetNullValue=No campaign selected}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="14" Foreground="{StaticResource MutedBrush}" LineHeight="21" MaxWidth="720" HorizontalAlignment="Left" Text="{Binding CampaignSummary}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,18,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoadSampleCommand}" Content="Load Sample Campaign"/>
                                        <Button Command="{Binding SetupLocalAiCommand}" Content="Start Local AI"/>
                                        <Button Command="{Binding SaveCommand}" Content="Save State"/>
                                    </WrapPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#0E131C" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Eyebrow}" Text="SESSION SNAPSHOT"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{StaticResource MutedBrush}" Text="Location" Margin="0,0,0,11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CurrentLocationName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Foreground="{StaticResource MutedBrush}" Text="Campaign time" Margin="0,0,0,11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="{Binding CampaignTime}" Margin="0,0,0,11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Foreground="{StaticResource MutedBrush}" Text="AI runtime"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding LocalAiStatus}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="-2,0,-2,8">
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="PARTY LOCATION"/>
                                    <TextBlock Style="{StaticResource MetricValue}" Margin="0,9,0,4" Text="{Binding CurrentLocationName}"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Active campaign position"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="LOCAL AI"/>
                                    <TextBlock Style="{StaticResource MetricValue}" FontSize="17" Margin="0,9,0,4" Text="{Binding LocalAiStatus}" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding LocalAiSetupProgress}" TextWrapping="Wrap" MaxHeight="34"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="RULES INDEX"/>
                                    <TextBlock Style="{StaticResource MetricValue}" Margin="0,9,0,4" Text="{Binding RuleChunkCount}"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Local SRD knowledge chunks"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="SYSTEM STATUS"/>
                                    <TextBlock Style="{StaticResource MetricValue}" Foreground="{StaticResource SuccessBrush}" Margin="0,9,0,4" Text="READY"/>
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Deterministic engine online"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="4,0,4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="ACTIVE QUESTS" Margin="0"/>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Current objectives"/>
                                    </DockPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Quests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E131C" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}"/>
                                                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{StaticResource GoldSoftBrush}" CornerRadius="6" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Top">
                                                            <TextBlock Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="Bold" Text="{Binding Status}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="RECENT WORLD EVENTS" Margin="0"/>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="Campaign memory"/>
                                    </DockPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentEvents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Ellipse Width="5" Height="5" Fill="{StaticResource PurpleBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Campaigns">
                <Grid Margin="22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Title}" Text="Campaigns"/>
                        <ComboBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding SelectedCampaign}" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding NewCampaignName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <WrapPanel><Button Command="{Binding CreateCampaignCommand}" Content="Create"/><Button Command="{Binding ImportCampaignCommand}" Content="Quick Import"/><Button Command="{Binding CompileCampaignWithAiCommand}" Content="AI Compile File"/><Button Command="{Binding ExpandCampaignWithAiCommand}" Content="Expand Missing Content"/><Button Command="{Binding LoadSampleCommand}" Content="Load Sample"/></WrapPanel>
                        <WrapPanel><Button Command="{Binding SaveCommand}" Content="Save"/><Button Command="{Binding RunRehearsalCommand}" Content="Run Rehearsal"/><Button Command="{Binding DeleteCampaignCommand}" Content="Delete"/></WrapPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" Text="Quick Import: JSON or heuristic extraction. AI Compile File: extracts source canon first, then adds separately marked AI-expanded details needed for play. Expand Missing Content can rerun only the second stage." TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource GoldBrush}" Margin="0,10,0,0" Text="{Binding CampaignCompilerStatus}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" Margin="20,0,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Campaign Overview"/><TextBlock FontSize="22" Text="{Binding SelectedCampaign.Name}"/><TextBlock Margin="0,8" Text="{Binding SelectedCampaign.System}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedCampaign.Summary}" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Text="{Binding SelectedCampaign.Tone}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Campaign Readiness"/><TextBlock FontWeight="SemiBold" Text="{Binding ReadinessSummary}"/><TextBlock Margin="0,5,0,8" Foreground="{StaticResource GoldBrush}" Text="{Binding ExpansionSummary}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding ReadinessIssues}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock><Run FontWeight="SemiBold" Text="{Binding Severity, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Category, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Campaign Rehearsal"/><TextBlock FontWeight="SemiBold" Text="{Binding RehearsalSummary}"/><TextBlock Margin="0,5,0,8" Foreground="{StaticResource MutedBrush}" Text="Deterministic pre-play probes check travel reachability, ambiguous keys, merchant transactions, encounter readiness, secret leakage, timeline drift, and generated-detail references." TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding RehearsalFindings}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock><Run FontWeight="SemiBold" Text="{Binding Severity, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Scenario, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Merchant Test"/>
                                <ComboBox ItemsSource="{Binding Merchants}" SelectedItem="{Binding SelectedMerchant}" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding SelectedMerchantStock}" SelectedItem="{Binding SelectedStock}" DisplayMemberPath="ItemId" Margin="0,0,0,6"/>
                                <TextBlock Text="Select a character on the Characters tab, then buy one unit. Gold, stock, and inventory update together." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                <Button Command="{Binding BuySelectedItemCommand}" Content="Buy Selected Item" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Game Table">
                <Grid Margin="20,18,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="LIVE SESSION"/>
                            <TextBlock Style="{StaticResource Title}" Text="Game Table" Margin="0,4,0,2"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Text="Narration, exploration, party state, and tactical combat stay together here."/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#101720" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                                    <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding PlaySceneModeTitle}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#101720" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,8,0">
                                <TextBlock FontSize="11"><Run Text="{Binding CurrentLocationName, Mode=OneWay}"/><Run Text="  •  "/><Run Foreground="{StaticResource GoldBrush}" Text="{Binding CampaignTime, Mode=OneWay}"/></TextBlock>
                            </Border>
                            <Button Command="{Binding RollD20Command}" Content="{Binding RollD20ButtonText}" ToolTip="{Binding PendingPlayerRollPrompt}"/>
                            <Button Command="{Binding AdvanceTenMinutesCommand}" Content="+10 min" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.72*" MinWidth="430"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.28*" MinWidth="620"/>
                        </Grid.ColumnDefinitions>

                        <!-- Conversation and player controls -->
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="16,14,16,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Dungeon Master"/>
                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="The story stays here. Rules and state resolve behind the scenes."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding DmActivityText}"/>
                                </Grid>

                                <ListBox x:Name="SessionChatList" Grid.Row="1" ItemsSource="{Binding SessionChat}" Margin="8,0,8,0" Padding="6" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,4" Padding="12,10" CornerRadius="10" MaxWidth="720">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#111823"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Background" Value="#20283A"/>
                                                                <Setter Property="BorderBrush" Value="#39445D"/>
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="MaxWidth" Value="560"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="{Binding Speaker}" Margin="0,0,0,5"/>
                                                    <TextBlock FontSize="12" LineHeight="18" Text="{Binding Content}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="2" Background="#0E141D" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,1" Padding="12,8">
                                    <WrapPanel>
                                        <Button Command="{Binding LookAroundCommand}" Content="Look Around"/>
                                        <Button Command="{Binding TalkNearbyCommand}" Content="Talk" Margin="6,0,0,0"/>
                                        <Button Command="{Binding ContinueSceneCommand}" Content="Continue" Margin="6,0,0,0"/>
                                        <Button Command="{Binding QuickAttackCommand}" Content="Attack Target" Margin="6,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasActiveCombat}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding QuickEndTurnCommand}" Content="End Turn" Margin="6,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasActiveCombat}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </Border>

                                <Grid Grid.Row="3" Margin="12,10,12,12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,5" Text="Tell the DM what you do. Press Enter to send, Shift+Enter for a new line."/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PlayerInputBox" Grid.Column="0" Text="{Binding PlayerInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="68" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="PlayerInput_PreviewKeyDown"/>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding SendPlayerInputCommand}" Content="Send" Margin="8,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Persistent scene board. Exploration map automatically becomes the tactical battlefield in combat. -->
                        <Border Grid.Column="2" Background="#0B1017" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                            <Grid>
                                <!-- Exploration / travel view -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasActiveCombat}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:CampaignMapControl Campaign="{Binding SelectedCampaign}" ShowDmView="False" Revision="{Binding MapRevision}" SelectedLocation="{Binding SelectedLocation, Mode=TwoWay}"/>
                                    <Border VerticalAlignment="Top" Background="#E6101620" BorderBrush="#60343D53" BorderThickness="0,0,0,1" Padding="16,12">
                                        <DockPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource GoldBrush}" Text="CURRENT SCENE"/>
                                                <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" Text="{Binding CurrentLocationName}"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Text="WORLD / TRAVEL VIEW"/>
                                        </DockPanel>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Background="#EE0F151E" BorderBrush="#60343D53" BorderThickness="0,1,0,0" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource Eyebrow}" Text="WHERE YOU ARE"/>
                                                <TextBlock Margin="0,4,0,0" Foreground="#D7DCE6" FontSize="12" LineHeight="18" Text="{Binding CurrentLocationDescription}" TextWrapping="Wrap" MaxHeight="76"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource Eyebrow}" Text="PARTY"/>
                                                <ItemsControl ItemsSource="{Binding PartyCharacters}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#182130" BorderBrush="#334158" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,6,5">
                                                                <TextBlock FontSize="10"><Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Foreground="{StaticResource MutedBrush}" Text="HP "/><Run Text="{Binding CurrentHp, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding MaxHp, Mode=OneWay}"/></TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Tactical view -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasActiveCombat}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <controls:CombatGridControl Campaign="{Binding SelectedCampaign}" Encounter="{Binding SelectedEncounter}" Revision="{Binding MapRevision}" PreviewSpellId="{Binding SelectedPreparedSpell.Id}" PreviewCasterId="{Binding SelectedCharacter.Id}" PreviewCenterXText="{Binding SpellAreaCenterXInput}" PreviewCenterYText="{Binding SpellAreaCenterYInput}" PreviewDirection="{Binding SpellAreaDirectionInput}" PreviewSlotLevelText="{Binding SpellSlotLevelInput}"/>
                                    <Border VerticalAlignment="Top" Background="#E6101620" BorderBrush="#60343D53" BorderThickness="0,0,0,1" Padding="16,11">
                                        <DockPanel>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Eyebrow}" Foreground="{StaticResource GoldBrush}" Text="BATTLEFIELD"/>
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding SelectedEncounter.Name}"/>
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Text="{Binding ActiveTurnName}"/>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" Text="{Binding CombatStatus}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Background="#F20D131C" BorderBrush="#7A3B465E" BorderThickness="0,1,0,0" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <!-- A player at 0 HP must personally make the Death Saving Throw at the start of their turn. -->
                                                <Border Background="#2A171A" BorderBrush="#8E3945" BorderThickness="1" CornerRadius="9" Padding="12,9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlayerDeathSaveRequired}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <StackPanel>
                                                            <TextBlock Foreground="#FFB5BE" FontSize="10" FontWeight="Bold" Text="DEATH SAVING THROW REQUIRED"/>
                                                            <TextBlock Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Text="{Binding ActiveDeathSavePrompt}"/>
                                                            <TextBlock Foreground="#DDAFB6" FontSize="10" Margin="0,2,0,0" Text="{Binding ActiveDeathSaveStatus}"/>
                                                            <TextBlock Foreground="#AEB7C7" FontSize="10" Margin="0,3,0,0" Text="Roll 1d20 • 10+ succeeds • natural 1 = two failures • natural 20 = regain 1 HP"/>
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RollActiveDeathSaveCommand}" Content="🎲  Roll Death Save" MinWidth="150" Margin="16,0,0,0"/>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Any other authoritative player roll blocks normal combat controls until the player supplies it. -->
                                                <Border Background="#172032" BorderBrush="#49658C" BorderThickness="1" CornerRadius="9" Padding="12,9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding PlayerRollRequired}" Value="True"/>
                                                                        <Condition Binding="{Binding PlayerDeathSaveRequired}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <StackPanel>
                                                            <TextBlock Foreground="#9BC7FF" FontSize="10" FontWeight="Bold" Text="PLAYER ROLL REQUIRED"/>
                                                            <TextBlock Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" Text="{Binding PendingPlayerRollPrompt}" TextWrapping="Wrap"/>
                                                            <TextBlock Foreground="#AEB7C7" FontSize="10" Margin="0,3,0,0" Text="The deterministic game state is paused until this roll is resolved."/>
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding RollD20Command}" Content="{Binding RollD20ButtonText}" MinWidth="170" Margin="16,0,0,0"/>
                                                    </DockPanel>
                                                </Border>

                                                <!-- After an ordinary Death Save the PC remains at 0 HP and cannot act this turn. -->
                                                <Border Background="#151D29" BorderBrush="#38455B" BorderThickness="1" CornerRadius="9" Padding="12,9">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActivePlayerUnableToActAtZero}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="Bold" Text="0 HP • UNCONSCIOUS"/>
                                                            <TextBlock Foreground="#F4F6FA" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" Text="{Binding ActiveDeathSaveStatus}"/>
                                                            <TextBlock Foreground="#AEB7C7" FontSize="10" Margin="0,2,0,0" Text="The required Death Save has been resolved. No normal action or movement is available while unconscious."/>
                                                        </StackPanel>
                                                        <Button DockPanel.Dock="Right" Command="{Binding QuickEndTurnCommand}" Content="End Turn" MinWidth="100" Margin="16,0,0,0"/>
                                                    </DockPanel>
                                                </Border>

                                                <!-- Normal player-turn combat controls. -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlayerRollRequired}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ActivePlayerUnableToActAtZero}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Foreground="{StaticResource GoldBrush}" FontSize="11" FontWeight="Bold" Text="QUICK COMBAT"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock VerticalAlignment="Center" Foreground="#E4E8F0" FontWeight="SemiBold" FontSize="11" Text="Target" Margin="0,0,8,0"/>
                                                        <ComboBox Width="230" MinHeight="36" Background="#101722" Foreground="#F4F6FA" BorderBrush="#4B5A72" FontWeight="SemiBold" ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name"/>
                                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding QuickAttackCommand}" Content="Attack" Margin="10,0,0,0"/>
                                                        <Button Command="{Binding QuickEndTurnCommand}" Content="End Turn" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Background="#151D29" BorderBrush="#2D394D" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="18,0,0,0">
                                                <TextBlock Foreground="#D6DCE8" FontSize="11" FontWeight="SemiBold" Text="NPC turns run automatically"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Characters">
                <Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource Title}" Text="Characters"/><ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" Height="420"/><Button Command="{Binding AddQuickCharacterCommand}" Content="Add Test Character" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="20,40,0,0"><StackPanel><TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding SelectedCharacter.Name}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding SelectedCharacter.CharacterType}"/>
                        <UniformGrid Columns="6" Margin="0,18,0,12">
                            <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Level"/><TextBlock FontSize="22" Text="{Binding SelectedCharacter.Level}"/></StackPanel>
                            <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="AC"/><TextBlock FontSize="22" Text="{Binding SelectedCharacter.ArmorClass}"/></StackPanel>
                            <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="HP"/><TextBlock FontSize="22"><Run Text="{Binding SelectedCharacter.CurrentHp, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SelectedCharacter.MaxHp, Mode=OneWay}"/></TextBlock></StackPanel>
                            <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Temp HP"/><TextBlock FontSize="22" Text="{Binding SelectedCharacter.TempHp}"/></StackPanel>
                            <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Speed"/><TextBlock FontSize="22"><Run Text="{Binding SelectedCharacterEffectiveSpeed, Mode=OneWay}"/><Run Text=" ft"/></TextBlock></StackPanel>
                            <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Gold"/><TextBlock FontSize="22" Text="{Binding SelectedCharacter.Gold}"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel><Button Command="{Binding DamageCharacterCommand}" Content="Take 1 Damage"/><Button Command="{Binding HealCharacterCommand}" Content="Heal 1"/><Button Command="{Binding GrantTempHpCommand}" Content="Grant 5 Temp HP"/><Button Command="{Binding DeathSaveCommand}" Content="Death Save"/></WrapPanel>
                        <WrapPanel><Button Command="{Binding ShortRestCommand}" Content="Short Rest"/><Button Command="{Binding SpendHitDieCommand}" Content="Spend Hit Die"/><Button Command="{Binding LongRestCommand}" Content="Long Rest"/></WrapPanel>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Conditions"/><TextBlock Text="{Binding SelectedCharacterConditions}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Exhaustion"/><TextBlock Text="{Binding SelectedCharacter.ExhaustionLevel}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Death Saves"/><TextBlock Text="{Binding SelectedCharacterDeathSaves}"/></StackPanel>
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Concentration"/>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedCharacterConcentration}" Margin="0,2,0,8"/>
                                <WrapPanel>
                                    <TextBox Width="260" Text="{Binding ConcentrationEffectInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the spell or effect that requires Concentration"/>
                                    <Button Command="{Binding BeginConcentrationCommand}" Content="Begin Concentration"/>
                                    <Button Command="{Binding EndConcentrationCommand}" Content="End"/>
                                </WrapPanel>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Damage checks are resolved automatically by the deterministic engine." Margin="0,6,0,0"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Ongoing effects" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding SelectedCharacterOngoingEffects}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="Public Knowledge"/><TextBlock Text="{Binding SelectedCharacter.PublicKnowledge}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="Inventory"/><ItemsControl ItemsSource="{Binding SelectedCharacter.Inventory}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding ItemId, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Spellcasting">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" Text="Spellcasting"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Spell slots, components, spell attacks, saving throws, healing, upcasting, Rituals, and Concentration are resolved by the deterministic engine." TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="18,8,0,0" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" Text="{Binding SpellcastingSummary}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Prepared Spells"/>
                            <TextBlock Grid.Row="1" Margin="0,2,0,8" Foreground="{StaticResource MutedBrush}" Text="{Binding SpellSlotsSummary}" TextWrapping="Wrap"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding PreparedSpells}" SelectedItem="{Binding SelectedPreparedSpell}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                            <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="Level "/><Run Text="{Binding Level, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding CastingTime, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SelectedPreparedSpell.Name}"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,2,0,12"><Run Text="Level "/><Run Text="{Binding SelectedPreparedSpell.Level, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SelectedPreparedSpell.School, Mode=OneWay}"/></TextBlock>
                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Casting Time"/><TextBlock Text="{Binding SelectedPreparedSpell.CastingTime}"/></StackPanel>
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Range"/><TextBlock Text="{Binding SelectedPreparedSpell.Range}"/></StackPanel>
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Components"/><TextBlock Text="{Binding SelectedPreparedSpell.Components}"/></StackPanel>
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Duration"/><TextBlock Text="{Binding SelectedPreparedSpell.Duration}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Configured Effect"/>
                            <TextBlock Margin="0,4,0,16" Text="{Binding SelectedPreparedSpell.Effect}" TextWrapping="Wrap"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Target"/>
                                    <ComboBox ItemsSource="{Binding SpellTargets}" SelectedItem="{Binding SelectedSpellTarget}" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Slot Level"/>
                                    <TextBox Text="{Binding SpellSlotLevelInput, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Multi-target / projectile allocation (optional)"/>
                                <TextBox Text="{Binding SpellTargetAllocationInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter exact target names, keys, or IDs separated by commas. Projectile spells use one entry per projectile unless a single target receives all. Multi-target buffs use one entry per creature."/>
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="Leave blank to use the selected Target. Use comma-separated entries for Bless, Magic Missile, Scorching Ray, and future multi-target spells." TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Area Center X"/><TextBox Text="{Binding SpellAreaCenterXInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Area Center Y"/><TextBox Text="{Binding SpellAreaCenterYInput, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Area Direction"/><TextBox Text="{Binding SpellAreaDirectionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="north, northeast, east, southeast, south, southwest, west, or northwest"/></StackPanel>
                            </Grid>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="Point-origin areas such as Fireball use Center X/Y. Self-origin cones and cubes such as Burning Hands and Thunderwave use Direction." TextWrapping="Wrap"/>
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding CastAsRitual}" Foreground="{StaticResource TextBrush}" Content="Cast as Ritual when the spell supports it"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Command="{Binding CastSelectedSpellCommand}" Content="Cast Spell"/>
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="In combat, Action and Bonus Action spells require the caster's turn. Reaction spells may be cast outside it. A creature can expend only one spell slot to cast a spell during a turn." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Spell Library">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" Text="Local Spell Library"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Browse the bundled SRD spell metadata offline. The app clearly separates rules metadata from spell effects that have been implemented deterministically." TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="18,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"><Run Text="SRD catalog: "/><Run Text="{Binding SpellCatalogCount, Mode=OneWay}"/><Run Text=" spells • "/><Run Text="{Binding SpellImplementedCount, Mode=OneWay}"/><Run Text=" deterministic"/></TextBlock>
                    </DockPanel>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding SpellLibraryQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Search spell name, school, or exact level"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SpellLibrary}" SelectedItem="{Binding SelectedLibrarySpell}">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="Level "/><Run Text="{Binding Level, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding School, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding SelectedLibrarySpell.Name}"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,2,0,14"><Run Text="Level "/><Run Text="{Binding SelectedLibrarySpell.Level, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding SelectedLibrarySpell.School, Mode=OneWay}"/></TextBlock>
                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Casting Time"/><TextBlock Text="{Binding SelectedLibrarySpell.CastingTime}"/></StackPanel>
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Range"/><TextBlock Text="{Binding SelectedLibrarySpell.Range}"/></StackPanel>
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Components"/><TextBlock Text="{Binding SelectedLibrarySpell.Components}"/></StackPanel>
                                <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Duration"/><TextBlock Text="{Binding SelectedLibrarySpell.Duration}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Engine Status"/>
                            <TextBlock Margin="0,4,0,12" Text="{Binding SelectedLibrarySpell.Status}" TextWrapping="Wrap"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Metadata-only spells are intentionally not cast by the deterministic engine yet. This prevents the local AI from reconstructing or guessing unimplemented spell mechanics."/>
                            <Separator Margin="0,16"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Source"/>
                            <TextBlock><Run Text="{Binding SelectedLibrarySpell.SourceReference, Mode=OneWay}"/><Run Text=" • page "/><Run Text="{Binding SelectedLibrarySpell.SourcePage, Mode=OneWay}"/></TextBlock>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"><Run Text="Ritual: "/><Run Text="{Binding SelectedLibrarySpell.Ritual, Mode=OneWay}"/><Run Text="    Concentration: "/><Run Text="{Binding SelectedLibrarySpell.Concentration, Mode=OneWay}"/><LineBreak/><Run Text="Resolution mode: "/><Run Text="{Binding SelectedLibrarySpell.Resolution, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Combat">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" Text="Combat"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Deterministic initiative, attacks, HP, and turn order. The AI can request these actions, but the engine resolves them." TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="18,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Text="{Binding CombatStatus}"/>
                    </DockPanel>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Encounters"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedEncounter}" Margin="0,6,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                            <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="{Binding Status, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Summary, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2">
                                <Button Command="{Binding ActivateEncounterCommand}" Content="Activate"/>
                                <Button Command="{Binding RollInitiativeCommand}" Content="Roll Initiative"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Combatants"/>
                            <ListView Grid.Row="1" ItemsSource="{Binding Combatants}" Margin="0,6,0,10">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding CharacterType}"/>
                                        <GridViewColumn Header="Side" Width="78" DisplayMemberBinding="{Binding Side}"/>
                                        <GridViewColumn Header="Init" Width="55" DisplayMemberBinding="{Binding Initiative}"/>
                                        <GridViewColumn Header="AC" Width="45" DisplayMemberBinding="{Binding ArmorClass}"/>
                                        <GridViewColumn Header="HP" Width="90">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock><Run Text="{Binding CurrentHp, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MaxHp, Mode=OneWay}"/></TextBlock></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Temp" Width="55" DisplayMemberBinding="{Binding TempHp}"/>
                                        <GridViewColumn Header="Grid" Width="70">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock><Run Text="("/><Run Text="{Binding GridX, Mode=OneWay}"/><Run Text=","/><Run Text="{Binding GridY, Mode=OneWay}"/><Run Text=")"/></TextBlock></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Move" Width="65" DisplayMemberBinding="{Binding MovementRemainingFeet}"/>
                                        <GridViewColumn Header="Action" Width="62" DisplayMemberBinding="{Binding ActionAvailable}"/>
                                        <GridViewColumn Header="Bonus" Width="62" DisplayMemberBinding="{Binding BonusActionAvailable}"/>
                                        <GridViewColumn Header="Attacks" Width="62" DisplayMemberBinding="{Binding AttacksRemainingInAction}"/>
                                        <GridViewColumn Header="Reaction" Width="70" DisplayMemberBinding="{Binding ReactionAvailable}"/>
                                        <GridViewColumn Header="Disengage" Width="75" DisplayMemberBinding="{Binding Disengaging}"/>
                                        <GridViewColumn Header="Dodge" Width="62" DisplayMemberBinding="{Binding Dodging}"/>
                                        <GridViewColumn Header="Conditions" Width="150" DisplayMemberBinding="{Binding Conditions}"/>
                                        <GridViewColumn Header="Grapple" Width="190" DisplayMemberBinding="{Binding GrappleStatus}"/>
                                        <GridViewColumn Header="Help" Width="130" DisplayMemberBinding="{Binding HelpStatus}"/>
                                        <GridViewColumn Header="Hidden" Width="62" DisplayMemberBinding="{Binding Hidden}"/>
                                        <GridViewColumn Header="Ready" Width="260" DisplayMemberBinding="{Binding ReadyStatus}"/>
                                        <GridViewColumn Header="Concentration" Width="150" DisplayMemberBinding="{Binding Concentration}"/>
                                        <GridViewColumn Header="Attacks" Width="230" DisplayMemberBinding="{Binding AttackNames}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Attacker"/><ComboBox ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedAttacker}" DisplayMemberPath="Name"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Foreground="{StaticResource MutedBrush}" Text="Target"/><ComboBox ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name"/></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="The tactical grid uses 5-foot squares. Orthogonal and diagonal adjacent squares each cost 5 feet. Attacks and configured spells enforce range when both combatants are positioned." TextWrapping="Wrap"/>
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Command="{Binding CombatAttackCommand}" Content="Resolve Attack"/>
                                    <Button Command="{Binding NextCombatTurnCommand}" Content="Next Turn"/>
                                    <Button Command="{Binding EndEncounterCommand}" Content="End Encounter"/>
                                </WrapPanel>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Move selected attacker to grid square" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center" Text="X" Margin="0,0,4,0"/>
                                <TextBox Width="55" Text="{Binding CombatMoveXInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Text="Y" Margin="10,0,4,0"/>
                                <TextBox Width="55" Text="{Binding CombatMoveYInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Command="{Binding MoveCombatantCommand}" Content="Move" Margin="10,0,0,0"/>
                                <Button Command="{Binding TakeDisengageCommand}" Content="Disengage" Margin="8,0,0,0"/>
                                <Button Command="{Binding TakeDashCommand}" Content="Dash" Margin="8,0,0,0"/>
                                <Button Command="{Binding TakeDodgeCommand}" Content="Dodge" Margin="8,0,0,0"/>
                                <Button Command="{Binding TakeHideCommand}" Content="Hide" Margin="8,0,0,0"/>
                                <Button Command="{Binding SearchHiddenCommand}" Content="Find Hidden" Margin="8,0,0,0"/>
                                <Button Command="{Binding HelpAttackCommand}" Content="Help Attack" Margin="8,0,0,0"/>
                                <Button Command="{Binding GrappleCommand}" Content="Grapple" Margin="8,0,0,0"/>
                                <Button Command="{Binding ShoveProneCommand}" Content="Shove Prone" Margin="8,0,0,0"/>
                                <Button Command="{Binding ShovePushCommand}" Content="Shove 5 ft" Margin="8,0,0,0"/>
                                <Button Command="{Binding StandFromProneCommand}" Content="Stand" Margin="8,0,0,0"/>
                                <Button Command="{Binding EscapeGrappleCommand}" Content="Escape Grapple" Margin="8,0,0,0"/>
                                <Button Command="{Binding ReleaseGrappleCommand}" Content="Release Grapple" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Skill / tool" Margin="0,0,6,0"/>
                                <TextBox Width="125" Text="{Binding CombatSkillInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="DC" Margin="10,0,4,0"/>
                                <TextBox Width="55" Text="{Binding CombatDcInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Command="{Binding HelpAbilityCheckCommand}" Content="Help Check" Margin="10,0,0,0"/>
                                <Button Command="{Binding FirstAidCommand}" Content="First Aid" Margin="8,0,0,0"/>
                                <Button Command="{Binding SearchActionCommand}" Content="Search" Margin="8,0,0,0"/>
                                <Button Command="{Binding StudyActionCommand}" Content="Study" Margin="8,0,0,0"/>
                                <Button Command="{Binding InfluenceActionCommand}" Content="Influence" Margin="8,0,0,0"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Ready trigger" Margin="0,0,6,0"/>
                                <TextBox Width="300" Text="{Binding ReadyTriggerInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Command="{Binding ReadyAttackCommand}" Content="Ready Attack" Margin="10,0,0,0"/>
                                <Button Command="{Binding ReadyMoveCommand}" Content="Ready Move" Margin="8,0,0,0"/>
                                <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding CombatPreparedSpells}" SelectedItem="{Binding SelectedCombatPreparedSpell}" DisplayMemberPath="Name"/>
                                <Button Command="{Binding ReadySpellCommand}" Content="Ready Spell" Margin="8,0,0,0"/>
                                <Button Command="{Binding TriggerReadiedActionCommand}" Content="Trigger Readied Action" Margin="8,0,0,0"/>
                            </WrapPanel>
                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding PendingMoveSummary}" TextWrapping="Wrap"/>
                                    <ComboBox Margin="0,6,0,0" Width="300" HorizontalAlignment="Left" ItemsSource="{Binding PendingOpportunityAttacks}" SelectedItem="{Binding SelectedOpportunityAttack}" DisplayMemberPath="ReactorName"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                    <Button Command="{Binding ResolveOpportunityAttackCommand}" Content="Take Opportunity Attack"/>
                                    <Button Command="{Binding DeclineOpportunityAttackCommand}" Content="Decline"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Battlefield">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" Text="Tactical Battlefield"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="A live 5-foot grid view of the selected combat encounter. Movement is still committed through the deterministic Combat controls."/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="18,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" Text="{Binding CombatStatus}"/>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <controls:CombatGridControl Campaign="{Binding SelectedCampaign}" Encounter="{Binding SelectedEncounter}" Revision="{Binding MapRevision}" PreviewSpellId="{Binding SelectedPreparedSpell.Id}" PreviewCasterId="{Binding SelectedCharacter.Id}" PreviewCenterXText="{Binding SpellAreaCenterXInput}" PreviewCenterYText="{Binding SpellAreaCenterYInput}" PreviewDirection="{Binding SpellAreaDirectionInput}" PreviewSlotLevelText="{Binding SpellSlotLevelInput}" MinHeight="480"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="World Map">
                <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="2"><TextBlock Style="{StaticResource Title}" Text="World Map"/><CheckBox DockPanel.Dock="Right" Margin="10" IsChecked="{Binding ShowDmMap}" Foreground="{StaticResource TextBrush}" Content="DM view"/></DockPanel>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}"><controls:CampaignMapControl Campaign="{Binding SelectedCampaign}" ShowDmView="{Binding ShowDmMap}" Revision="{Binding MapRevision}" SelectedLocation="{Binding SelectedLocation, Mode=TwoWay}"/></Border>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,6,0,0"><TextBlock Style="{StaticResource SectionTitle}" Text="Locations"/><ListBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" DisplayMemberPath="Name" Height="360"/><TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4" Text="{Binding SelectedLocation.Name}"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding SelectedLocation.Description}" TextWrapping="Wrap"/><WrapPanel Margin="0,10,0,0"><Button Command="{Binding RevealLocationCommand}" Content="Reveal"/><Button Command="{Binding MovePartyCommand}" Content="Move Party"/></WrapPanel></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="World State">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel><TextBlock Style="{StaticResource Title}" Text="World State"/><TextBlock Foreground="{StaticResource MutedBrush}" Text="Factions, relationships, secrets, and scheduled world events compiled from the campaign."/></StackPanel>
                        <CheckBox DockPanel.Dock="Right" Margin="12,8" IsChecked="{Binding ShowDmMap}" Foreground="{StaticResource TextBrush}" Content="DM view"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Factions"/>
                                <ListBox ItemsSource="{Binding FactionDisplays}" Margin="0,6,0,0">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Knowledge}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Secrets"/>
                                <ListBox ItemsSource="{Binding SecretDisplays}" Margin="0,6,0,0">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Text="{Binding Truth}" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding RevealConditions}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Relationships"/>
                                <ListBox ItemsSource="{Binding RelationshipDisplays}" Margin="0,6,0,0">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Margin="4,6"><Run Text="{Binding SourceKey, Mode=OneWay}"/><Run Text="  →  "/><Run FontWeight="SemiBold" Text="{Binding Relation, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding TargetKey, Mode=OneWay}"/></TextBlock></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Timeline (DM view)"/>
                                <ListBox ItemsSource="{Binding TimelineDisplays}" Margin="0,6,0,0">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Schedule, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Consequence}" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Notes}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="AI-Expanded Details"/>
                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="Generated playability details remain explicitly separate from source canon. Player-safe details are shown normally; DM-only details appear only in DM view." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding GeneratedDetails}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock FontWeight="SemiBold"><Run Text="{Binding TargetKey, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Category, Mode=OneWay}"/></TextBlock><TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Content}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Rules">
                <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2"><TextBlock Style="{StaticResource Title}" Text="Rules Library"/><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Command="{Binding SearchRulesCommand}" Content="Search"/><TextBox Text="{Binding RuleQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/></DockPanel></StackPanel>
                    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding RuleResults}" SelectedItem="{Binding SelectedRuleResult}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock FontWeight="SemiBold" Text="{Binding Heading}"/><TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="Page "/><Run Text="{Binding Page, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding Section, Mode=OneWay}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0"><ScrollViewer><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SelectedRuleResult.Heading}"/><TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="SRD page "/><Run Text="{Binding SelectedRuleResult.Page, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,12,0,0" Text="{Binding SelectedRuleResult.Text}" TextWrapping="Wrap" FontSize="15" LineHeight="22"/></StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer><StackPanel Margin="22" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Style="{StaticResource Title}" Text="Settings"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Local AI Runtime"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="The app installs and runs llama.cpp locally. On the first start, the selected GGUF model must download before it can be loaded into memory and the GPU. Startup progress and raw runtime output are shown below."/>
                            <Label Margin="0,10,0,0" Content="llama-server URL"/>
                            <TextBox Text="{Binding Settings.LlamaServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Margin="0,8,0,0" Content="Model name sent to the local API"/>
                            <TextBox Text="{Binding Settings.ModelName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Margin="0,8,0,0" Content="Hugging Face GGUF model"/>
                            <TextBox Text="{Binding Settings.HuggingFaceModel, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Margin="0,8,0,0" Content="Optional local GGUF model path (overrides Hugging Face)"/>
                            <TextBox Text="{Binding Settings.ModelPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><Label Content="Context size"/><TextBox Text="{Binding Settings.ContextSize, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="2"><Label Content="GPU layers"/><TextBox Text="{Binding Settings.GpuLayers, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Grid>
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding Settings.PlayerSafeMode}" Foreground="{StaticResource TextBrush}" Content="Strict player-safe secret boundaries"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SetupLocalAiCommand}" Content="Start Local AI"/>
                                <Button Command="{Binding TestAiCommand}" Content="Test AI Reply"/>
                                <Button Command="{Binding StopLocalAiCommand}" Content="Stop Local AI"/>
                                <Button Command="{Binding SaveCommand}" Content="Save Settings"/>
                            </WrapPanel>
                            <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding LocalAiStatus}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding LocalAiSetupProgress}" TextWrapping="Wrap"/>
                            <Border Margin="0,12,0,0" Background="#090D13" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="RUNTIME OUTPUT" Margin="0,0,0,6"/>
                                    <TextBox IsReadOnly="True" Text="{Binding LocalAiRuntimeLog, Mode=OneWay}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Background="Transparent" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="190"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Local Data"/><TextBlock Text="{Binding DataPath}" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="Campaign state is stored locally. The first alpha uses an atomic JSON persistence layer while the final schema migrates to SQLite." TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#0C1017" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="14,7"><DockPanel><TextBlock Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="Bold" Text="STATUS" Margin="0,0,12,0"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding StatusMessage}"/></DockPanel></Border>
    </Grid>
</Window>
